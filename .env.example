# Claude API credentials
CLAUDE_PROXY_ANTHROPIC_API_KEY=sk-ant-api03-xxxxx

# Optional: Custom Anthropic API base URL
# CLAUDE_PROXY_ANTHROPIC_BASE_URL=https://api.anthropic.com

# Server configuration
CLAUDE_PROXY_HOST=0.0.0.0
CLAUDE_PROXY_PORT=8080

# Time-based access control
# Timezone for schedule evaluation (IANA timezone name)
CLAUDE_PROXY_TIMEZONE=America/New_York

# Allowed days (0=Monday, 6=Sunday) - JSON array format
CLAUDE_PROXY_ALLOWED_DAYS=[0,1,2,3,4]

# Time window (24-hour format)
CLAUDE_PROXY_START_HOUR=9
CLAUDE_PROXY_START_MINUTE=0
CLAUDE_PROXY_END_HOUR=17
CLAUDE_PROXY_END_MINUTE=0

# Optional: Bypass key for emergency access
# CLAUDE_PROXY_BYPASS_KEY=your-secret-bypass-key
